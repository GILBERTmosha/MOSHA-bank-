{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Authenticated office owner profile",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["email", "createdAt"]
    },
    "users/{userId}/officeData/balances": {
      "title": "Account Balances",
      "description": "Mama Ela, Ela Yangu, and Ela ya Matumizi balances",
      "properties": {
        "mamaEla": { "type": "number" },
        "elaYangu": { "type": "number" },
        "elaYaMatumizi": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["mamaEla", "elaYangu", "elaYaMatumizi"]
    },
    "users/{userId}/officeData/settings": {
      "title": "Office Settings",
      "description": "Bank settings, Passkey, Sign, and Logo",
      "properties": {
        "companyName": { "type": "string" },
        "tagline": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "logoUrl": { "type": "string" },
        "currency": { "type": "string" },
        "passkey": { "type": "string" },
        "securitySign": { "type": "string" },
        "autoLockMinutes": { "type": "number" },
        "hideBalancesByDefault": { "type": "boolean" },
        "smsSenderName": { "type": "string" }
      },
      "required": ["companyName", "passkey"]
    },
    "users/{userId}/loans": {
      "title": "Loans",
      "description": "Borrowers, loan details, fees, and repayments",
      "properties": {
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "clientEmail": { "type": "string" },
        "principalAmount": { "type": "number" },
        "feeAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "balanceRemaining": { "type": "number" },
        "status": { "type": "string" },
        "loanDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "collateral": { "type": "string" },
        "notes": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "createdAt": { "type": "number" },
        "sourcePocket": { "type": "string" }
      },
      "required": ["clientName", "clientPhone", "principalAmount", "totalAmount", "balanceRemaining"]
    },
    "users/{userId}/expenses": {
      "title": "Expenses",
      "description": "Daily operational expenses and bills",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "pocket": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "amount", "date", "pocket"]
    }
  }
}
